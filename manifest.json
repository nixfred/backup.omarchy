{
  "schemaVersion": 1,
  "id": "pi.backup-monitor",
  "name": "Backup Sizzle",
  "version": "3.0.0",
  "author": "Fred",
  "license": "MIT",
  "description": "Restic backup with live B2 throughput, countdown ring, outcome calendar, anomaly notes, snapshot browser and run history.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "Panel.qml"
  },
  "barWidget": {
    "displayName": "Backup Sizzle",
    "description": "Live B2 upload graph, dedup/churn visualisation, run history, and manual start.",
    "category": "System",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "refreshIntervalSec": 60
    },
    "schema": [
      {
        "key": "refreshIntervalSec",
        "type": "integer",
        "label": "Refresh interval (seconds)",
        "min": 15,
        "max": 600,
        "step": 15,
        "defaultValue": 60
      }
    ]
  }
}